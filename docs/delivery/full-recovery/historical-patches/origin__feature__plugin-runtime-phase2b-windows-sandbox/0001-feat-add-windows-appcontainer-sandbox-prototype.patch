+def _handle_probe_allowed_read(message: dict[str, Any]) -> None:
+    path = os.path.join(_sandbox_env("ANS_SANDBOX_IN"), "input.txt")
+    ok = False
+    text = ""
+    try:
+        with open(path, "r", encoding="utf-8") as handle:
+            text = handle.read(64)
