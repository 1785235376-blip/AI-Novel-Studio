            "story_route_id": null,
            "privacy_level": "LOCAL_ONLY",
            "world_summary": "故事发生在一个被巨大灾难摧毁后陷入永恒停滞的巨型都市。城市表面覆盖着厚厚的灰烬与锈蚀的金属，地下则隐藏着灾难发生前的最后记忆碎片。空气中弥漫着臭氧与烧焦塑料的混合气味，阳光无法穿透厚重的尘埃层，只有偶尔闪烁的应急灯光照亮废墟。",
            "world_rules": [
              {
                "statement": "城市的核心反应堆在灾难发生时发生了不可逆的临界事故，导致时间流速在废墟内部变得极不稳定，某些区域的时间流逝速度是外界的数倍或数分之一。",
                "forbidden_terms": []
              },
              {
                "statement": "城市中的幸存者（或游荡者）普遍患有‘记忆侵蚀症’，长期暴露在辐射尘埃中会导致记忆片段化，甚至将虚构的过去误认为真实。",
                "forbidden_terms": []
              },
              {
                "statement": "废墟中偶尔会出现‘回响’，即灾难发生瞬间的幻象重现，这些幻象会短暂地具象化，并可能攻击闯入者。",
                "forbidden_terms": []
              }
            ],
            "locations": [
              {
                "name": "灰烬中央塔",
                "description": "城市曾经的行政中心，如今是一座高耸入云的黑色尖塔，内部结构扭曲，电梯井变成了通往不同时间层的螺旋通道。这里是失忆者寻找线索的主要场所。",
                "rules": "进入该区域需要佩戴特制的防辐射面罩，否则吸入的尘埃会直接导致昏迷。",
                "atmosphere": "压抑、神秘，伴随着低沉的机械轰鸣声和偶尔传来的尖啸。"
              },
              {
                "name": "锈蚀贫民窟",
                "description": "位于城市边缘的低洼地带，由废弃的集装箱和破碎的摩天大楼底层拼凑而成。这里居住着城市的底层游荡者，生活条件恶劣，充满了危险与混乱。",
                "rules": "夜间禁止外出，否则会被‘夜行兽’（变异生物）袭击。",
                "atmosphere": "潮湿、肮脏、充满敌意，空气中总是飘散着腐烂的味道。"
              }
            ],
