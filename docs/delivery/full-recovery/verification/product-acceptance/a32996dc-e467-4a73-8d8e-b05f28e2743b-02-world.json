            "story_route_id": null,
            "privacy_level": "LOCAL_ONLY",
            "world_summary": "故事发生在一个被未知力量瞬间抹去的巨型都市“新伊甸”。城市如今只剩下钢筋水泥的骨架和弥漫的酸雨，被称为“废城”。空气中漂浮着未消散的纳米尘埃，它们既是维持城市残骸不立即坍塌的粘合剂，也是记录城市毁灭前最后时刻数据的载体。社会结构已崩塌，幸存者生活在地下掩体或废墟顶层，依靠回收旧时代的科技苟延残喘。核心冲突围绕着一份被加密的“毁灭日志”展开，主角作为唯一的失忆者，其记忆碎片与日志内容逐渐重合，揭示出他并非无辜的受害者，而是启动城市自毁程序的“清道夫”。",
            "world_rules": [
              {
                "statement": "城市毁灭并非由单一武器造成，而是由遍布城市的‘净化协议’纳米机器人自主执行，它们将有机物质转化为无害的无机尘埃。",
                "forbidden_terms": []
              },
              {
                "statement": "废城中的酸雨含有高浓度的记忆抑制因子，长期暴露会导致居民出现短暂的失忆或人格解离。",
                "forbidden_terms": []
              },
              {
                "statement": "城市核心的‘黑匣子’是唯一能读取完整毁灭日志的终端，但激活它需要特定的生物密钥（即主角的血液或脑波）。",
                "forbidden_terms": []
              },
              {
                "statement": "在废城，‘过去’被视为禁忌，因为大多数幸存者认为毁灭是某种神圣的救赎，试图挖掘真相会被视为亵渎。",
                "forbidden_terms": []
              },
              {
                "statement": "纳米尘埃在特定频率的声波下会重组，短暂恢复城市局部的功能（如照明、重力），但随即再次崩溃。",
                "forbidden_terms": []
              }
            ],
            "locations": [
              {
                "name": "中央尖塔废墟",
                "description": "曾经是新伊甸的行政中心和城市大脑所在地。现在是一座高达千米的破碎玻璃柱，内部充满了闪烁的故障灯光和漂浮的纳米尘埃风暴。这里是所有数据的源头，也是主角最终必须面对真相的地方。",
                "rules": "进入尖塔需要穿戴防酸雨服，否则皮肤会迅速腐蚀。",
                "atmosphere": "压抑、神圣而恐怖，伴随着电流的滋滋声和回声。"
              },
              {
                "name": "下层掩体‘静默区’",
                "description": "位于城市地下的巨大避难所，居住着绝大多数幸存者。这里没有窗户，只有模拟的星空投影。人们在这里互相隐瞒身份，严禁提及‘上面’发生了什么。",
                "rules": "禁止讨论‘净化协议’，禁止展示任何带有旧时代标志的物品。",
                "atmosphere": "沉闷、拥挤、充满猜忌和压抑的恐惧。"
              },
              {
                "name": "记忆回廊",
                "description": "城市边缘的一片区域，这里的纳米尘埃浓度异常高，偶尔会形成短暂的幻象，重现城市毁灭前的繁华景象。主角在这里第一次看到了自己的模糊影像。",
                "rules": "长时间停留会导致严重的精神错乱，分不清现实与幻象。",
                "atmosphere": "迷幻、美丽却令人不安，充满破碎的光影。"
              }
            ],
