            "story_route_id": null,
            "privacy_level": "LOCAL_ONLY",
            "world_summary": "故事发生在一座被巨大灾难摧毁后陷入永恒停滞的巨型都市“新巴别塔”。城市表面覆盖着厚厚的尘埃与变异植被，内部结构错综复杂，充满了旧时代的科技残骸与未知的辐射区。空气中弥漫着臭氧与腐烂金属的味道。这座城市的毁灭并非自然原因，而是源于一次失控的量子实验，而实验的主导者正是主角本人。城市现在由一种名为“回声”的集体潜意识现象笼罩，居民（或幸存者）的行为受过去记忆碎片的影响，导致社会秩序混乱。主角在寻找自我身份的过程中，逐渐揭开城市毁灭的真相，并面临是否要阻止“回声”完全吞噬现实，或是接受自己作为毁灭者的命运。",
            "world_rules": [
              {
                "statement": "城市中的‘回声’现象会强制重现过去的关键时刻，干扰当前行动。",
                "forbidden_terms": []
              },
              {
                "statement": "旧时代的科技设备在接触特定频率的声波时会自我激活或爆炸。",
                "forbidden_terms": []
              },
              {
                "statement": "主角的记忆缺失并非偶然，而是城市防御系统为了掩盖真相而植入的。",
                "forbidden_terms": []
              },
              {
                "statement": "城市中心的核心反应堆从未真正关闭，它仍在以微弱但致命的频率运转。",
                "forbidden_terms": []
              },
              {
                "statement": "任何试图修复城市的行为都会触发‘回声’的强烈反弹，导致记忆混乱。",
                "forbidden_terms": []
              }
            ],
            "locations": [
              {
                "name": "记忆回廊",
                "description": "城市边缘的一条废弃地铁隧道，墙壁上投射着无数模糊的人脸和破碎的记忆片段。这里是主角最常出现的地方，也是他试图拼凑自己过去的起点。",
                "rules": "进入回廊的人可能会陷入无限循环的梦境中，无法分辨现实与幻觉。",
                "atmosphere": "压抑、神秘、充满心理暗示"
              },
              {
                "name": "静默区",
                "description": "城市中心的一片绝对安静区域，没有任何声音传播。这里是旧时代实验的核心地带，也是主角最终发现真相的地方。",
                "rules": "任何声音都会引发剧烈的空间扭曲和物理伤害。",
                "atmosphere": "死寂、寒冷、令人不安"
              },
              {
                "name": "废墟广场",
                "description": "曾经繁华的商业中心，现在只剩下倒塌的高楼和扭曲的金属结构。这里聚集着少数幸存者，他们依靠旧时代的自动售货机维持生命。",
                "rules": "自动售货机有时会吐出带有记忆碎片的食物或物品。",
                "atmosphere": "荒凉、混乱、充满生存本能"
              }
            ],
