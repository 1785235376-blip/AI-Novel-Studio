            "story_route_id": null,
            "privacy_level": "LOCAL_ONLY",
            "world_summary": "新纪元 2147 年，人类因过度依赖“记忆云”而丧失了独立思考与情感连接，城市沦为巨大的数据服务器与监控网络。主角林渊是一名失忆的“清道夫”，在废弃的旧城区寻找自己的过去。随着调查深入，他发现城市毁灭的真相并非外敌入侵，而是源于一种名为“静默协议”的集体潜意识崩溃，而触发这一崩溃的源头，正是他自己在一次试图拯救他人的实验中，无意中释放了能够抹除所有人类记忆的病毒。",
            "world_rules": [
              {
                "statement": "城市的基础设施完全由残留的‘记忆云’数据驱动，物理世界的运行逻辑依赖于人类集体潜意识的稳定输出。",
                "forbidden_terms": []
              },
              {
                "statement": "一旦人类的集体记忆出现大规模断层或崩溃，城市的防御系统、能源网络及重力控制将立即失效，导致物理法则的局部崩塌。",
                "forbidden_terms": []
              },
              {
                "statement": "‘静默协议’是一种能够强制清除个体及群体特定记忆的病毒程序，它没有实体，只能通过引发极端的心理恐慌或绝望来激活。",
                "forbidden_terms": []
              },
              {
                "statement": "主角林渊拥有‘回溯’能力，可以短暂地读取并重构过去 24 小时内的场景，但他无法直接修改已发生的记忆，只能看到真相的碎片。",
                "forbidden_terms": []
              },
              {
                "statement": "废弃城市中的‘回音’是过去居民强烈情感残留的具象化现象，它们既是线索也是危险的幻觉，可能引导人走向自我毁灭。",
                "forbidden_terms": []
              }
            ],
            "locations": [
              {
                "name": "零号记忆塔",
                "description": "城市的核心控制中枢，一座高耸入云的黑色尖塔，内部充满了流动的数据流和破碎的影像。这里是‘记忆云’的源头，也是城市毁灭的起点。",
                "rules": "进入零号记忆塔需要极高的精神稳定性，否则会被海量的历史数据冲垮意识，变成一具行尸走肉。",
                "atmosphere": "压抑、冰冷、充满电流的嗡鸣声，空气中弥漫着臭氧和旧时代尘埃的味道。"
              },
              {
                "name": "锈蚀回廊",
                "description": "连接旧城区与零号记忆塔的地下通道，布满了生锈的管道和坍塌的墙壁。这里是主角寻找线索的主要场所，也是‘回音’最频繁出现的地方。",
                "rules": "在锈蚀回廊中，时间流速是不稳定的，可能会因为强烈的恐惧或回忆而突然停滞或加速。",
                "atmosphere": "潮湿、阴暗、回声缭绕，偶尔能听到远处模糊的哭泣声或争吵声。"
              },
              {
                "name": "静默广场",
                "description": "城市中心曾经最繁华的广场，如今只剩下巨大的全息投影残骸和满地狼藉。这里是‘静默协议’首次大规模激活的地方，也是主角最终面对真相的场所。",
                "rules": "在静默广场，所有的电子设备都会自动关闭，任何试图使用科技手段的行为都会受到强烈的精神干扰。",
                "atmosphere": "死寂、空旷、令人窒息的孤独感，阳光透过破碎的穹顶洒下，却照不亮心中的黑暗。"
              }
            ],
