            "story_route_id": null,
            "privacy_level": "LOCAL_ONLY",
            "world_summary": "故事发生在一个被未知力量彻底摧毁后遗弃的巨型都市。城市表面覆盖着厚重的灰雾和变异植被，地下则隐藏着毁灭发生时的残骸与数据核心。空气中弥漫着一种名为‘静默’的法则，任何试图回忆或大声呼喊的行为都会引发局部的空间崩塌。主角在废墟中拾捡记忆碎片，逐渐拼凑出真相：他并非受害者，而是这场灾难的源头。",
            "world_rules": [
              {
                "statement": "城市禁止任何形式的‘声音’传播，包括语言、音乐和心跳的剧烈共鸣，否则会导致局部区域瞬间坍塌。",
                "forbidden_terms": []
              },
              {
                "statement": "失忆者无法通过常规手段恢复记忆，必须通过接触‘核心残骸’并承受精神反噬来解锁片段。",
                "forbidden_terms": []
              },
              {
                "statement": "城市中的变异生物（‘回声兽’）以人类的恐惧和记忆碎片为食，它们会模仿失忆者的声音来诱捕猎物。",
                "forbidden_terms": []
              },
              {
                "statement": "时间在城市废墟中是混乱的，不同区域的毁灭程度对应着不同的时间流速，导致因果律在局部失效。",
                "forbidden_terms": []
              },
              {
                "statement": "任何试图重建城市的行为都会触发‘自我毁灭协议’，这是城市防御机制的最后防线。",
                "forbidden_terms": []
              }
            ],
            "locations": [
              {
                "name": "灰雾边缘",
                "description": "城市的最外围，灰雾最浓重的地方。这里生长着巨大的金属藤蔓，偶尔能看到被遗忘的旧时代广告牌在雾中闪烁。是失忆者最初的栖息地，也是他第一次发现‘回声兽’的地方。",
                "rules": "禁止大声呼吸，否则会被灰雾吞噬。",
                "atmosphere": "压抑、潮湿、充满未知的恐惧。"
              },
              {
                "name": "中央广场·静默区",
                "description": "曾经繁华的商业中心，现在是一片巨大的空洞。地面裂开，露出下方仍在运转的旧时代服务器阵列，不断发出无声的蓝光。这里是记忆碎片最集中的地方。",
                "rules": "禁止触碰任何发光的物体，否则会被强制植入虚假记忆。",
                "atmosphere": "诡异的宁静，伴随着低频的嗡嗡声。"
              },
              {
                "name": "核心残骸·审判庭",
                "description": "城市地底深处，毁灭发生时的指挥中心。这里保存着主角过去所有的记忆数据，但也封印着他作为毁灭者的意识。只有直面真相才能通过这里。",
                "rules": "禁止携带任何武器，因为武器会加速空间的崩塌。",
                "atmosphere": "冰冷、宏大、令人窒息的绝望感。"
              }
            ],
