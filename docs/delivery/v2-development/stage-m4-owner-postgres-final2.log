    def test_lost_broker_reservation_receipt_keeps_claim_and_unknown_hold_without_retry(model_rig, monkeypatch):
        e = model_rig; spy_transport(e, monkeypatch)
        row = preview(e, admit(e)); reserve = e.broker.reserve
