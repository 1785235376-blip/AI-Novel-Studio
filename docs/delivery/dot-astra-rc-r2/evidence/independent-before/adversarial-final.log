        job=Job('repeat-continue-proposal','continue',novel['id'],chapter['id'],'','LOCAL_ONLY',status='COMPLETED',output='ONE NEW CHAPTER',base_chapter_version=chapter['version'])
        manager.jobs[job.id]=job
        entered,second_entered,release=Event(),Event(),Event()
        gate=Lock();count=[0]
        original=manager.chapters.create
        def create(*args):
            with gate:
                count[0]+=1
                if count[0]==1:entered.set()
                else:second_entered.set()
            assert release.wait(5)
            return original(*args)
        monkeypatch.setattr(manager.chapters,'create',create)
        def accept():
            try:return manager.accept(job.id)
            except (ValueError,VersionConflict) as exc:return type(exc).__name__
        with ThreadPoolExecutor(max_workers=2) as pool:
            first=pool.submit(accept);assert entered.wait(3)
            second=pool.submit(accept)
            # Old code lets second enter create; a correctly serialized acceptance
            # blocks it, so release the first after a bounded opportunity either way.
            second_entered.wait(0.25);release.set()
            results=[first.result(),second.result()]
        pending=bundle.canon.list_pending(novel['id'])
