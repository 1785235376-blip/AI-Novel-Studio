          "type": "string"
        },
        "channel_version": {
          "minimum": 1,
          "title": "Channel Version",
          "type": "integer"
        },
        "device_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Device Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Request Id",
          "type": "string"
        },
        "base_manifest_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Manifest Id"
        }
      },
      "required": [
        "channel_id",
        "channel_version",
        "device_id",
        "request_id"
      ],
      "title": "ManifestIn",
      "type": "object",
      "$id": "urn:ai-novel-studio:realtime-sync:v1:ManifestIn"
    },
    "TransferIn": {
      "additionalProperties": false,
      "properties": {
        "manifest_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "message_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Message Ids",
          "type": "array"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Request Id",
          "type": "string"
        },
        "acknowledge_copy_boundary": {
          "const": true,
          "title": "Acknowledge Copy Boundary",
          "type": "boolean"
        }
      },
      "required": [
        "manifest_id",
        "message_ids",
        "request_id",
        "acknowledge_copy_boundary"
      ],
      "title": "TransferIn",
      "type": "object",
      "$id": "urn:ai-novel-studio:realtime-sync:v1:TransferIn"
    },
    "TransferActionIn": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "action": {
          "enum": [
            "dispatch",
            "resume",
            "cancel"
          ],
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "expected_version",
        "action"
      ],
      "title": "TransferActionIn",
      "type": "object",
      "$id": "urn:ai-novel-studio:realtime-sync:v1:TransferActionIn"
    },
    "VersionIn": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "expected_version"
      ],
      "title": "VersionIn",
      "type": "object",
      "$id": "urn:ai-novel-studio:realtime-sync:v1:VersionIn"
    }
  }
