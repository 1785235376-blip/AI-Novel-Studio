          "title": "Action",
          "type": "string"
        },
        "recovery_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovery Digest"
        }
      },
      "required": [
        "expected_version",
        "action"
      ],
      "title": "OperationIn",
      "type": "object",
      "$id": "urn:ai-novel-studio:realtime-sync:v1:OperationIn"
    },
    "DeviceIn": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Device Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "label"
      ],
      "title": "DeviceIn",
      "type": "object",
      "$id": "urn:ai-novel-studio:realtime-sync:v1:DeviceIn"
    },
    "ManifestIn": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
