{
  "schema_version": 1,
  "status": "FUNCTIONAL_SURFACE_CONTRACT",
  "top_level_modules_added": [],
  "shared_states": {
    "LOADING": "Disable duplicate commands; retain original request ID/body and captured scope/version.",
    "EMPTY": "No participants, devices or manifests; never fabricate active people from membership.",
    "ERROR": "Show bounded error code; preserve local input and explicit retry/recovery path.",
    "UNAUTHORIZED": "Stop push and clear cached source/cursor content; server re-resolves current authority.",
    "DISABLED": "Server-owned runtime flag/dependencies off; direct routes fail closed before parsing input.",
    "NOT_CONFIGURED": "Production realtime/cloud/encryption and branch sync are unavailable; no fake success.",
    "PARTIAL": "Functional engineering and synthetic local transport only, no production deployment claim.",
    "CONFLICT": "Show preserved intent/current version; strict CAS, no silent rebase or last-write-wins.",
    "REVIEW": "Explicit prepare/apply or original inbox diff3 review; no automatic manuscript reconciliation.",
    "RECOVERY": "Inspect uncertain outcomes; adopt exact evidence or close without replay; never automatic retry."
  },
