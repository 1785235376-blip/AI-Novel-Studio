{
  "$id": "https://schemas.poemseed.dev/local-interop/v1/cancel-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "protocol_name": {
      "const": "PoemSeed Local Interop",
      "default": "PoemSeed Local Interop",
      "title": "Protocol Name",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    }
  },
  "required": [
    "protocol_name",
    "protocol_version",
    "request_id"
  ],
  "title": "CancelRequest",
  "type": "object"
}
