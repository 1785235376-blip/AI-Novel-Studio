{
  "$defs": {
    "ContextEvidence": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "AUTHORITATIVE",
            "CONSTRAINING",
            "SUPPORTING",
            "ADVISORY"
          ],
          "title": "Authority",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "maxLength": 256,
          "pattern": "^(?:app|project|chapter|task|runtime|model|selection|feature|interop|diagnostic|user-observation):[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$",
          "title": "Locator",
          "type": "string"
        },
        "privacy": {
          "default": "LOCAL_ONLY",
          "enum": [
            "LOCAL_ONLY",
            "REDACTION_REQUIRED",
            "CONSENTED_CLOUD"
          ],
          "title": "Privacy",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Source Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "locator",
        "content_hash",
        "timestamp",
        "authority"
      ],
      "title": "ContextEvidence",
      "type": "object"
    }
  },
  "$id": "https://schemas.poemseed.dev/local-interop/v1/verifier-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "privacy": {
                  "const": "LOCAL_ONLY"
                }
              }
            }
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "privacy_scope": {
            "enum": [
              "LOCAL_ONLY"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "privacy": {
                  "const": "REDACTION_REQUIRED"
                }
              }
            }
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "privacy_scope": {
            "enum": [
              "LOCAL_ONLY",
              "REDACTION_REQUIRED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "authority": {
                  "const": "AUTHORITATIVE"
                }
              }
            },
            "minItems": 1
          }
        },
        "required": [
          "evidence"
        ]
      }
    }
  ],
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContextEvidence"
      },
      "maxItems": 64,
      "title": "Evidence",
      "type": "array"
    },
    "privacy_scope": {
      "default": "LOCAL_ONLY",
      "enum": [
        "LOCAL_ONLY",
        "REDACTION_REQUIRED",
        "CONSENTED_CLOUD"
      ],
      "title": "Privacy Scope",
      "type": "string"
    },
    "protocol_name": {
      "const": "PoemSeed Local Interop",
      "default": "PoemSeed Local Interop",
      "title": "Protocol Name",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "reason": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "result_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Result Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "protocol_name",
    "protocol_version",
    "reason",
    "request_id",
    "result_id",
    "session_id",
    "status"
  ],
  "title": "VerifierResult",
  "type": "object"
}
