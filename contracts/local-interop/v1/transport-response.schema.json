    "VerificationCondition": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "const": "runtime_status"
              }
            }
          },
          "then": {
            "properties": {
              "expected_value": {
                "enum": [
                  "READY",
                  "LOADING",
                  "UNAVAILABLE",
                  "ERROR",
                  "UNKNOWN"
                ]
              },
              "operator": {
                "enum": [
                  "EQ",
                  "NE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "task_status"
              }
            }
          },
          "then": {
            "properties": {
              "expected_value": {
                "enum": [
                  "PENDING",
                  "QUEUED",
                  "RUNNING",
                  "WAITING",
                  "FAILED",
                  "COMPLETED",
                  "CANCELLED",
                  "BLOCKED",
                  "UNKNOWN"
                ]
              },
              "operator": {
                "enum": [
                  "EQ",
                  "NE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "project_version"
              }
            }
          },
          "then": {
            "properties": {
              "expected_value": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "EQ",
                  "NE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "chapter_version"
              }
            }
          },
          "then": {
            "properties": {
              "expected_value": {
                "type": "integer"
              }
            }
          }
        }
      ],
      "properties": {
        "expected_value": {
          "anyOf": [
            {
              "enum": [
                "PENDING",
                "QUEUED",
                "RUNNING",
                "WAITING",
                "FAILED",
                "COMPLETED",
                "CANCELLED",
                "BLOCKED",
                "UNKNOWN"
              ],
              "type": "string"
            },
            {
              "enum": [
                "READY",
                "LOADING",
                "UNAVAILABLE",
                "ERROR",
                "UNKNOWN"
              ],
              "type": "string"
            },
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
              "type": "string"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Expected Value"
        },
        "field": {
          "enum": [
            "runtime_status",
            "task_status",
            "project_version",
            "chapter_version"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "default": "EQ",
          "enum": [
            "EQ",
            "NE",
            "GTE"
          ],
          "title": "Operator",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "field",
        "expected_value",
        "source_id"
      ],
      "title": "VerificationCondition",
      "type": "object"
    },
    "VerifierResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "privacy": {
