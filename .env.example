APP_NAME=AI Novel Studio
APP_ENV=development
APP_VERSION=0.7.0
STORAGE_BACKEND=file
ENABLE_LORE_CONTEXT=false
ENABLE_CONTINUITY_RULES=false
PROJECT_ROOT=.
NOVEL_DATA_PATH=./novel_data
BACKUP_PATH=./backups
DATABASE_BACKUP_PATH=./database/backups
PROMPT_PATH=./prompts
WORKFLOW_PATH=./workflows
KNOWLEDGE_SOURCE_PATH=./novel_data/novels
POSTGRES_HOST=localhost
POSTGRES_PORT=54329
POSTGRES_DB=ai_novel_studio
POSTGRES_USER=novel_studio
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://novel_studio:change-me@localhost:54329/ai_novel_studio
DIFY_BASE_URL=http://localhost:5001
OLLAMA_BASE_URL=http://host.docker.internal:11434
MOCK_PROVIDER=true
MOCK_STREAM_DELAY_MS=35
MOCK_FAILURE_MODE=
FRONTEND_ORIGIN=http://localhost:5173
LOCAL_PROVIDER=ollama
DEFAULT_MODEL=qwen2.5:7b-instruct-q4_K_M
LOCAL_UTILITY_MODEL=qwen2.5:7b-instruct-q4_K_M
LOCAL_WRITER_MODEL=qwen2.5:7b-instruct-q4_K_M
LOCAL_REVIEW_MODEL=qwen2.5:7b-instruct-q4_K_M
DEFAULT_CLOUD_PROVIDER=
CLOUD_WRITER_PROVIDER=
CLOUD_WRITER_MODEL=
CLOUD_PLANNER_PROVIDER=
CLOUD_PLANNER_MODEL=
CLOUD_REVIEW_PROVIDER=
CLOUD_REVIEW_MODEL=
CLOUD_EDITOR_PROVIDER=
CLOUD_EDITOR_MODEL=
EMBEDDING_MODEL=nomic-embed-text
CREATION_PROFILE=HYBRID
ENABLE_CLOUD=true
ENABLE_LOCAL_REVIEW=true
ENABLE_PROVIDER_FALLBACK=true
PRIMARY_WRITER_PROVIDER=
SECONDARY_WRITER_PROVIDER=
LOCAL_FALLBACK_MODEL=qwen2.5:7b-instruct-q4_K_M
MODEL_TIMEOUT=120
MAX_RETRY=2
MAX_REVISION_COUNT=2
DAILY_API_BUDGET=0
MONTHLY_API_BUDGET=0
CHAPTER_API_BUDGET=0
ENABLE_COST_GUARD=true
LOG_LEVEL=INFO
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ENABLE_OPTIMISTIC_CONCURRENCY=false
ENABLE_CONTEXT_PACK_V2=false
AUTOSAVE_IDLE_DEBOUNCE_SECONDS=3
AUTOSAVE_PERIODIC_SECONDS=30
ENABLE_COLLABORATION_RUNTIME=false
ENABLE_PACKAGED_RUNTIME=false
# Provider secrets: auto | windows | keyring | memory. Packaged builds must keep memory fallback disabled.
CREDENTIAL_VAULT_BACKEND=auto
CREDENTIAL_VAULT_SERVICE=AI-Novel-Studio
CREDENTIAL_VAULT_ALLOW_MEMORY_FALLBACK=true
# Comma-separated loopback hosts explicitly trusted for local Provider imports.
OUTBOUND_LOOPBACK_ALLOWLIST=
# Local-only bootstrap for opaque trusted sessions. Do not commit real tokens.
# COLLABORATION_DEV_SESSIONS_JSON=[{"token":"replace-me","session_id":"session-a","client_id":"client-a","actor_id":"user-a","workspace_id":"workspace-a"}]
# AUDIO is a first-class domain. When provider_id=auto, reachable local services
# are selected in this order before any configured cloud provider.
AUDIO_DASHENG_LOCAL_ENDPOINT=http://127.0.0.1:8001/v1
AUDIO_STABLE_AUDIO_LOCAL_ENDPOINT=http://127.0.0.1:8002/v1
AUDIO_MMAUDIO_LOCAL_ENDPOINT=http://127.0.0.1:8003/v1
