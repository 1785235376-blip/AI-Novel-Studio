@@ -0,0 +1,19 @@
+// @vitest-environment jsdom
+// [HERMIA-FE-20261024 M6] TaskCenter error alerts: human text, no raw code visible.
+import { cleanup, render, waitFor } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { ApiError } from '../api';
+import { TaskCenter } from './TaskCenter';
+import { problemText, TASK_CENTER_PROBLEM_FALLBACK } from './problemText';
+
+afterEach(cleanup);
+
+describe('[HERMIA-FE-20261024 M6] problemText', () => {
+  it('keeps a human message and never returns the raw code', () => {
+    expect(problemText({ code: 'STUDIO_REQUEST_FAILED', message: '原记录或功能当前不可用。' })).toBe('原记录或功能当前不可用。');
+    expect(problemText({ code: 'STUDIO_REQUEST_FAILED', message: 'STUDIO_REQUEST_FAILED' })).toBe(TASK_CENTER_PROBLEM_FALLBACK);
+    expect(problemText({ code: 'X', message: 'SOME_RAW_CODE' })).toBe(TASK_CENTER_PROBLEM_FALLBACK);
+    expect(problemText({ code: 'X', message: '  ' })).toBe(TASK_CENTER_PROBLEM_FALLBACK);
+    expect(problemText(undefined)).toBe(TASK_CENTER_PROBLEM_FALLBACK);
+  });
+});
diff --git a/frontend/src/taskcenter/problemText.ts b/frontend/src/taskcenter/problemText.ts
new file mode 100644
index 00000000..d36cb949
--- /dev/null
+++ b/frontend/src/taskcenter/problemText.ts
@@ -0,0 +1,12 @@
+// [HERMIA-FE-20261024 M6] TaskCenter alerts show human text only. The raw problem code (e.g. STUDIO_REQUEST_FAILED)
+// is never rendered as visible text; callers keep it in a data-error-code attribute for diagnostics.
+import type { TaskCenterProblem } from './taskCenterTypes';
+
+export const TASK_CENTER_PROBLEM_FALLBACK = '请求没有完成，请稍后点「重新读取」。';
+const RAW_CODE = /^[A-Z][A-Z0-9_]*$/;
+
+export function problemText(problem: TaskCenterProblem | undefined): string {
+  const message = (problem?.message ?? '').trim();
+  if (!message || RAW_CODE.test(message) || (problem?.code && message === problem.code)) return TASK_CENTER_PROBLEM_FALLBACK;
+  return message;
+}
