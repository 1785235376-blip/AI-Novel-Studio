+@pytest.mark.parametrize('target', EXACT_METADATA_TARGETS)
+def test_unknown_exact_time_fields_have_explicit_losses(target):
+    pytest.importorskip('opentimelineio')
+    doc, raw, exact, path = exact_metadata_fixture(target)
