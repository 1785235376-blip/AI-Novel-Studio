+    before={'assets':len(list(rig.assets.root.glob('*.bin'))),'timelines':len(timelines(rig))}
+    with rig.raw_store.transaction(rig.nid,rig.scope) as state:
+        row=state['collections'][COLLECTION][first['id']]
