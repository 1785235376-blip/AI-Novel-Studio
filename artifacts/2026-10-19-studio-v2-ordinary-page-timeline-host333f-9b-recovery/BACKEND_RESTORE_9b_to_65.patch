+def test_corrupt_durable_receipt_never_guesses_or_adopts_assets(rig, handoff, monkeypatch, corruption):
+    value = body(rig, handoff, [page(rig, handoff)])
+    def stop(*args, **kwargs): raise OSError('planned but no Asset')
